# Copia este archivo a .env.local y llena los valores (no se versiona).
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_MAPBOX_TOKEN=pk.<token-publico>

# Token SECRETO de Mapbox (scope DOWNLOADS:READ) para compilar el SDK de Android.
# No va en .env: regístralo como variable secreta de EAS:
#   npx eas-cli@latest env:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value sk.<...> --visibility secret
